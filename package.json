{
  "name": "web-rotate-core",
  "version": "0.4.0",
  "description": "One Gateway for All WebSearch/WebFetch Providers!",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "benchmark": "bun run benchmark/run.ts",
    "check": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run security"
  },
  "dependencies": {
    "@hyperbrowser/sdk": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@truto/turndown-plugin-gfm": "^1.0.6",
    "@types/turndown": "^5.0.6",
    "defuddle": "~0.19.6",
    "duck-duck-scrape": "^2.2.7",
    "es-toolkit": "^1.53.0",
    "exa-js": "^2.26.0",
    "fast-xml-parser": "^5.11.2",
    "file-type": "^22.2.0",
    "google-sr": "^6.0.0",
    "html-to-text": "^10.0.1",
    "keenable": "~0.1.2",
    "linkedom": "~0.18.14",
    "marked": "^18.1.1",
    "p-map": "^7.1.1",
    "scrapfly-sdk": "~0.12.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/html-to-text": "^9.0.4",
    "@biomejs/biome": "^2.6.4",
    "typescript": "^7.0.2"
  }
}
